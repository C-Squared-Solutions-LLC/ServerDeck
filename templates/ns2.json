{
  "template": "ns2",
  "title": "Natural Selection 2",
  "category": "Shooters",
  "burden": {"ram_gb": 1, "ram_gb_per_player": 0.02, "cpu_cores": 0.4, "cpu_cores_per_player": 0.04, "players": 24, "note": "wants a fast CPU core - a slow one lags before the server is full"},
  "description": "Natural Selection 2 dedicated server (Steam app 4940) - game port and the next one (Steam query), UDP. Its config, logs and downloaded mods stay in folders next to the server (so backups include the config). Its web admin is on for this PC only (http://127.0.0.1:<web port>, user admin): kicks, bans, chat and map changes are done there. ServerDeck shows who is on through the Steam query; it can't warn players before a restart (updates wait until nobody is on) and stops it with Ctrl+C. About 2-4 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "ns2", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Natural Selection 2"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\NS2"},
    {"key": "server_name", "label": "Server name (in the browser)", "default": "My NS2 Server"},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 27175, "help": "the next port (UDP) answers the Steam query"},
    {"key": "map", "label": "Start map", "default": "ns2_summit"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 24},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "web_port", "label": "Web admin port (TCP, this PC only)", "type": "int", "default": 8095},
    {"key": "web_password", "label": "Web admin password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "max_players": "{max_players}",
    "type": "win_process",
    "appid": 4940,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_4940.acf",
    "exe": "x64\\Server.exe",
    "cwd": ".",
    "args": ["-name", "{server_name}", "-port", "{port}", "-map", "{map}", "-limit", "{max_players}", "-password", "{password}",
             "-config_path", "{install_dir}\\config", "-logdir", "{install_dir}\\logs", "-modstorage", "{install_dir}\\mods",
             "-webadmin", "-webdomain", "127.0.0.1", "-webport", "{web_port}", "-webuser", "admin", "-webpassword", "{web_password}"],
    "ports": [["udp", "{port}"], ["udp", "{port+1}"]],
    "query": {"port": "{port+1}"},
    "player_notes": {"ban": "NS2 bans and kicks on its web admin page (http://127.0.0.1:<web port>) or with sv_ban in its console.",
                     "roles": "Admins: config\\ServerAdmin.json (Configs)."},
    "stop_method": "ctrl_c",
    "stop_timeout": 60,
    "start_timeout": 600,
    "firewall": "auto",
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 0},
    "backup": {"paths": ["config"], "dest": "{backup_root}\\{id}"},
    "config_files": ["config/*.json", "config/*.txt"],
    "logs": {"server log": "{install_dir}\\logs\\*.txt"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
