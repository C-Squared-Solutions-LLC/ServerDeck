{
  "template": "conan",
  "title": "Conan Exiles (Enhanced)",
  "category": "Survival / crafting",
  "burden": {"ram_gb": 6, "ram_gb_per_player": 0.06, "cpu_cores": 1, "cpu_cores_per_player": 0.03, "players": 40},
  "description": "Conan Exiles dedicated server (Steam app 443030) - the Unreal Engine 5 \"Enhanced\" version, which is the public branch now (the older build is Steam's conan-exiles-legacy branch). On the first start ServerDeck writes the server name, join password, admin password and slots into its ini files, and before every start keeps RCON on (only this PC can reach it - its port isn't opened) for who is on, player counts and restart warnings in chat (broadcast). Kicks, bans and admin rights: the in-game admin panel (admin password), or the RCON console under Logs & console. The world is ConanSandbox\\Saved\\game_0.db (in the backups). Stops use Ctrl+C. Uses UDP 7797/7798 and query 27025 here (the usual 7777 and 27015 are SCUM's on this PC). About 6-10 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "conan", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Conan Exiles"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\ConanExiles"},
    {"key": "server_name", "label": "Server name (in the server list)", "default": "My Conan Exiles Server", "help": "written to Engine.ini on the first start - change it there later"},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "admin_password", "label": "Admin password (in game)", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 7797, "help": "the next UDP port is used too"},
    {"key": "query_port", "label": "Query port (UDP)", "type": "int", "default": 27025},
    {"key": "rcon_port", "label": "RCON port (TCP, this PC only)", "type": "int", "default": 25575},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 40},
    {"key": "rcon_password", "label": "RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "max_players": "{max_players}",
    "type": "win_process",
    "appid": 443030,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_443030.acf",
    "exe": "ConanSandboxServer.exe",
    "process": "ConanSandboxServer-Win64-*.exe",
    "args": ["-log", "-Port={port}", "-QueryPort={query_port}", "-MaxPlayers={max_players}"],
    "ports": [["udp", "{port}"], ["udp", "{port+1}"], ["udp", "{query_port}"], ["tcp", "{rcon_port}"]],
    "query": {"port": "{query_port}"},
    "rcon": {"kind": "source", "port": "{rcon_port}", "password": "{rcon_password}", "say": "broadcast {msg}"},
    "players": "conan_rcon",
    "stop_method": "ctrl_c",
    "stop_timeout": 120,
    "start_timeout": 1200,
    "firewall": "auto",
    "announce": "rcon_say",
    "health": {"startup_grace": 1200},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "pre_start": [
      ["settings", {"file": "ConanSandbox\\Saved\\Config\\WindowsServer\\Engine.ini", "format": "ini",
        "seed": {"OnlineSubsystem/ServerName": "{server_name}", "OnlineSubsystem/ServerPassword": "{password}"}}],
      ["settings", {"file": "ConanSandbox\\Saved\\Config\\WindowsServer\\ServerSettings.ini", "format": "ini",
        "seed": {"ServerSettings/AdminPassword": "{admin_password}", "ServerSettings/MaxPlayers": "{max_players}"},
        "enforce": {"ServerSettings/RconEnabled": "True", "ServerSettings/RconPassword": "{rcon_password}", "ServerSettings/RconPort": "{rcon_port}"}}],
      ["settings", {"file": "ConanSandbox\\Saved\\Config\\WindowsServer\\Game.ini", "format": "ini",
        "enforce": {"RconPlugin/RconEnabled": "1", "RconPlugin/RconPassword": "{rcon_password}", "RconPlugin/RconPort": "{rcon_port}",
                    "RconPlugin/RconMaxKarma": "60"}}]
    ],
    "backup": {"paths": ["ConanSandbox\\Saved"], "exclude": ["Logs", "Crashes"], "dest": "{backup_root}\\{id}"},
    "config_files": ["ConanSandbox/Saved/Config/WindowsServer/*.ini"],
    "logs": {"server log": "{install_dir}\\ConanSandbox\\Saved\\Logs\\ConanSandbox.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
