{
  "template": "sons_of_the_forest",
  "title": "Sons of the Forest",
  "category": "Survival / crafting",
  "burden": {"ram_gb": 4, "ram_gb_per_player": 0.25, "cpu_cores": 0.8, "cpu_cores_per_player": 0.12, "players": 8},
  "description": "Sons of the Forest dedicated server (Steam app 2465200) - three UDP ports (game, Steam query, blob sync). Its settings, saves and logs live in a userdata folder next to the server (so backups include them): ServerDeck writes dedicatedserver.cfg before the first start (name, slots, join password, game mode) and keeps its ports in step afterwards. Admins are Steam IDs in ownerswhitelist.txt (Configs). It has no remote console, so players can't be warned before a restart (updates wait until nobody is on), and ServerDeck sees only who is on. It saves every 10 minutes (SaveInterval); stops use Ctrl+C. About 4-8 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "sotf", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Sons of the Forest"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\SonsOfTheForest"},
    {"key": "server_name", "label": "Server name (in the server list)", "default": "My Sons of the Forest Server", "help": "written to dedicatedserver.cfg on the first start - change it there later"},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 8},
    {"key": "game_mode", "label": "Game mode", "default": "Normal", "help": "Peaceful, Normal, Hard, HardSurvival or Custom"},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 8766},
    {"key": "query_port", "label": "Query port (UDP)", "type": "int", "default": 27016},
    {"key": "blob_port", "label": "Blob sync port (UDP)", "type": "int", "default": 9700}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "max_players": "{max_players}",
    "type": "win_process",
    "appid": 2465200,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_2465200.acf",
    "exe": "SonsOfTheForestDS.exe",
    "args": ["-userdatapath", "{install_dir}\\userdata"],
    "ports": [["udp", "{port}"], ["udp", "{query_port}"], ["udp", "{blob_port}"]],
    "query": {"port": "{query_port}"},
    "player_notes": {"ban": "Sons of the Forest has no ban list ServerDeck can write: use a join password, or kick in game as an admin.",
                     "roles": "Admins: Steam IDs in userdata\\ownerswhitelist.txt (Configs), one per line."},
    "stop_method": "ctrl_c",
    "stop_timeout": 120,
    "start_timeout": 900,
    "firewall": "auto",
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 0},
    "pre_start": [["settings", {"file": "userdata\\dedicatedserver.cfg", "format": "json",
      "create": {"IpAddress": "0.0.0.0", "GamePort": "{port}", "QueryPort": "{query_port}", "BlobSyncPort": "{blob_port}",
                 "ServerName": "{server_name}", "MaxPlayers": "{max_players}", "Password": "{password}", "LanOnly": false,
                 "SaveSlot": 1, "SaveMode": "Continue", "GameMode": "{game_mode}", "SaveInterval": 600,
                 "IdleDayCycleSpeed": 0.0, "IdleTargetFramerate": 5, "ActiveTargetFramerate": 60,
                 "LogFilesEnabled": true, "TimestampLogFilenames": true, "TimestampLogEntries": true,
                 "SkipNetworkAccessibilityTest": true, "GameSettings": {}, "CustomGameModeSettings": {}},
      "enforce": {"GamePort": "{port}", "QueryPort": "{query_port}", "BlobSyncPort": "{blob_port}"}}]],
    "backup": {"paths": ["userdata"], "exclude": ["logs"], "dest": "{backup_root}\\{id}"},
    "config_files": ["userdata/dedicatedserver.cfg", "userdata/ownerswhitelist.txt"],
    "logs": {"server log": "{install_dir}\\userdata\\logs\\*.txt"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
