{
  "template": "cs2",
  "title": "Counter-Strike 2",
  "description": "Counter-Strike 2 dedicated server (Steam app 730) with Metamod:Source and CounterStrikeSharp kept working across game updates. Needs a Game Server Login Token from steamcommunity.com/dev/managegameservers (app 730) to show up in the public server list.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "cs2", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Counter-Strike 2"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\CS2"},
    {"key": "port", "label": "Game port (UDP/TCP)", "type": "int", "default": 27015},
    {"key": "map", "label": "Start map", "default": "de_dust2"},
    {"key": "gslt", "label": "Game Server Login Token", "default": "", "secret": true, "help": "optional - without one the server is LAN/direct-connect only"},
    {"key": "rcon_password", "label": "RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "type": "win_process",
    "appid": 730,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_730.acf",
    "exe": "game\\bin\\win64\\cs2.exe",
    "args": ["-dedicated", "-console", "-condebug", "-usercon", "-ip", "0.0.0.0", "-port", "{port}",
             "+game_type", "0", "+game_mode", "1", "+map", "{map}",
             "+sv_setsteamaccount", "{gslt}", "+rcon_password", "{rcon_password}"],
    "ports": [["udp", "{port}"], ["tcp", "{port}"]],
    "query": {"port": "{port}"},
    "rcon": {"kind": "source", "port": "{port}", "password": "{rcon_password}"},
    "stop_method": "rcon",
    "stop_timeout": 30,
    "start_timeout": 300,
    "firewall": "auto",
    "announce": "rcon_say",
    "perf": {"kind": "cs2_stats"},
    "health": {"min_fps_idle": 48, "min_fps_busy": 48, "startup_grace": 300},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "mods": "cs2",
    "css_version": "latest",
    "mod_releases": {"css": "roflmuffin/CounterStrikeSharp"},
    "pre_start": [["cs2_gameinfo"], ["rotate", "game\\csgo\\addons\\metamod\\console.log", 20, 3]],
    "post_update": [["cs2_addons"]],
    "preserve": ["game\\csgo\\cfg\\server.cfg", "game\\csgo\\cfg\\gamemode_competitive_server.cfg"],
    "backup": {"paths": ["game\\csgo\\cfg", "game\\csgo\\addons\\counterstrikesharp\\configs",
                         "game\\csgo\\addons\\counterstrikesharp\\plugins"], "dest": "{backup_root}\\{id}"},
    "config_files": ["game/csgo/cfg/server.cfg", "game/csgo/cfg/*_server.cfg", "game/csgo/cfg/autoexec.cfg",
                     "game/csgo/addons/counterstrikesharp/configs/*.json",
                     "game/csgo/addons/counterstrikesharp/configs/plugins/**/*.json"],
    "logs": {
      "server console": "{install_dir}\\game\\csgo\\addons\\metamod\\console.log",
      "CounterStrikeSharp": "{install_dir}\\game\\csgo\\addons\\counterstrikesharp\\logs\\log-all*.txt"
    },
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
