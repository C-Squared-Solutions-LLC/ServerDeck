{
  "template": "hl2dm",
  "title": "Half-Life 2: Deathmatch",
  "category": "Shooters",
  "burden": {"ram_gb": 0.3, "ram_gb_per_player": 0.01, "cpu_cores": 0.2, "cpu_cores_per_player": 0.02, "players": 16},
  "description": "Half-Life 2: Deathmatch dedicated server (Steam app 232370), the 32-bit srcds.exe (SteamCMD's public download lacks complete 64-bit server files; the 32-bit server takes at most 33 players). ServerDeck sets the name and join password in server.cfg on the first start and keeps its RCON password in step, lists who is on with kicks and bans over RCON (bans go into banned_user.cfg and are applied again after every start), warns players in chat before restarts and stops it cleanly. Admins: the RCON password, or SourceMod's admins_simple.ini. Under 1 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "hl2dm", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Half-Life 2: Deathmatch"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\HL2DM"},
    {"key": "server_name", "label": "Server name (in the browser)", "default": "My HL2:DM Server", "help": "written to server.cfg on the first start - change it there later"},
    {"key": "port", "label": "Game port (UDP/TCP)", "type": "int", "default": 27155},
    {"key": "map", "label": "Start map", "default": "dm_lockdown"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 16, "help": "up to 33"},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "rcon_password", "label": "RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "max_players": "{max_players}",
    "type": "win_process",
    "appid": 232370,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_232370.acf",
    "exe": "srcds.exe",
    "exe_fallback": "srcds_win64.exe",
    "args": ["-console", "-game", "hl2mp", "-port", "{port}", "+ip", "0.0.0.0", "-nohltv", "-condebug",
             "+maxplayers", "{max_players}", "+map", "{map}", "+rcon_password", "{rcon_password}"],
    "ports": [["udp", "{port}"], ["tcp", "{port}"]],
    "query": {"port": "{port}"},
    "rcon": {"kind": "source", "port": "{port}", "password": "{rcon_password}"},
    "players": "srcds_rcon",
    "stop_method": "rcon",
    "stop_timeout": 30,
    "start_timeout": 300,
    "firewall": "auto",
    "announce": "rcon_say",
    "health": {"startup_grace": 300},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "pre_start": [["settings", {"file": "hl2mp\\cfg\\server.cfg", "format": "cfg",
      "seed": {"hostname": "{server_name}", "sv_password": "{password}"}, "enforce": {"rcon_password": "{rcon_password}"}}],
                  ["rotate", "hl2mp\\console.log", 20, 3]],
    "backup": {"paths": ["hl2mp\\cfg", "hl2mp\\addons"], "dest": "{backup_root}\\{id}"},
    "config_files": ["hl2mp/cfg/server.cfg", "hl2mp/cfg/mapcycle.txt", "hl2mp/cfg/banned_user.cfg"],
    "logs": {"server console": "{install_dir}\\hl2mp\\console.log", "server logs": "{install_dir}\\hl2mp\\logs\\*.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
