{
  "template": "serious_sam_3",
  "title": "Serious Sam 3: BFE",
  "category": "Shooters",
  "burden": {"ram_gb": 0.6, "ram_gb_per_player": 0.03, "cpu_cores": 0.25, "cpu_cores_per_player": 0.05, "players": 8},
  "description": "Serious Sam 3: BFE dedicated server (Steam app 41080) - one UDP port. Pick the game mode below (the server starts its first level); everything else is a Serious Engine setting you can add to its arguments in config.json as +name value, or put in a Lua script it runs with +exec. It has no remote console ServerDeck speaks or Steam query it uses, so ServerDeck shows it online by its port, can't list or warn players, and stops it with Ctrl+C (Croteam's way). Up to 16 players. Under 1 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "ss3", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Serious Sam 3"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\SeriousSam3"},
    {"key": "server_name", "label": "Session name (in the browser)", "default": "My Serious Sam 3 Server"},
    {"key": "gamemode", "label": "Game mode", "default": "Cooperative", "help": "Cooperative, CooperativeCoinOp, TeamSurvival, BeastHunt, CaptureTheFlag, Deathmatch, InstantKill, LastManStanding, LastTeamStanding, MyBurden, TeamBeastHunt, TeamDeathmatch"},
    {"key": "port", "label": "Port (UDP)", "type": "int", "default": 27185},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 8, "help": "up to 16"},
    {"key": "rcon_password", "label": "Rcon password", "default": "", "secret": true, "generate": true, "help": "for Croteam's own rcon tool; left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "max_players": "{max_players}",
    "type": "win_process",
    "appid": 41080,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_41080.acf",
    "exe": "Bin\\Sam3_DedicatedServer.exe",
    "cwd": ".",
    "args": ["+port", "{port}", "+sessionname", "{server_name}", "+gamemode", "{gamemode}", "+maxplayers", "{max_players}",
             "+rconpass", "{rcon_password}", "+logfile", "{install_dir}\\Logs\\server.log"],
    "ports": [["udp", "{port}"]],
    "query": null,
    "stop_method": "ctrl_c",
    "stop_timeout": 60,
    "start_timeout": 300,
    "firewall": "auto",
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 0},
    "backup": {"paths": ["Content\\SeriousSam3\\Config"], "dest": "{backup_root}\\{id}"},
    "config_files": ["Content/SeriousSam3/Config/*.lua", "Content/SeriousSam3/Config/*.ini"],
    "logs": {"server log": "{install_dir}\\Logs\\server.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
