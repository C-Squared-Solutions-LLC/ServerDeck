{
  "template": "empyrion",
  "title": "Empyrion - Galactic Survival",
  "category": "Survival / crafting",
  "description": "Empyrion - Galactic Survival dedicated server (Steam app 530870), started without graphics. On the first start ServerDeck writes the server name, join password, slots and game name into dedicated.yaml, and before every start keeps its telnet console on (port not opened in the firewall) - for restart warnings in chat and a clean stop (saveandexit). ServerDeck sees who is on through the Steam query; kicks, bans and admin levels are telnet / in-game commands or Saves\\adminconfig.yaml (Configs). It starts a playfield server process per planet in use, so RAM grows with players: about 4-8 GB.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "empyrion", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Empyrion"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\Empyrion"},
    {"key": "server_name", "label": "Server name (in the server list)", "default": "My Empyrion Server", "help": "written to dedicated.yaml on the first start - change it there later"},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 8},
    {"key": "game_name", "label": "Save name", "default": "DediGame"},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 30000, "help": "it uses this and the next three UDP ports"},
    {"key": "telnet_port", "label": "Telnet console port (TCP, not opened)", "type": "int", "default": 30004},
    {"key": "telnet_password", "label": "Telnet password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "type": "win_process",
    "appid": 530870,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_530870.acf",
    "exe": "DedicatedServer\\EmpyrionDedicated.exe",
    "args": ["-batchmode", "-nographics", "-dedicated", "{install_dir}\\dedicated.yaml", "-logFile", "{install_dir}\\Logs\\Dedicated.log"],
    "ports": [["udp", "{port}"], ["udp", "{port+1}"], ["udp", "{port+2}"], ["udp", "{port+3}"]],
    "query": {"port": "{port+1}"},
    "rcon": {"kind": "telnet", "port": "{telnet_port}", "password": "{telnet_password}", "say": "say '{msg}'", "stop": ["saveandexit 0"]},
    "player_notes": {"ban": "Empyrion bans with its own commands (ban <id> <duration> over telnet or in game) or Saves\\adminconfig.yaml (Configs).",
                     "roles": "Admin levels are in Saves\\adminconfig.yaml (Configs)."},
    "stop_method": "rcon",
    "stop_timeout": 180,
    "start_timeout": 900,
    "firewall": "auto",
    "announce": "rcon_say",
    "health": {"startup_grace": 900},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "pre_start": [["settings", {"file": "dedicated.yaml", "format": "yaml",
      "seed": {"ServerConfig/Srv_Name": "{server_name}", "ServerConfig/Srv_Password": "{password}",
               "ServerConfig/Srv_MaxPlayers": "{max_players}", "GameConfig/GameName": "{game_name}"},
      "enforce": {"ServerConfig/Srv_Port": "{port}", "ServerConfig/Tel_Enabled": true, "ServerConfig/Tel_Port": "{telnet_port}",
                  "ServerConfig/Tel_Pwd": "{telnet_password}"}}]],
    "backup": {"paths": ["Saves", "dedicated.yaml"], "exclude": ["Cache"], "dest": "{backup_root}\\{id}"},
    "config_files": ["dedicated.yaml", "Saves/adminconfig.yaml"],
    "logs": {"server log": "{install_dir}\\Logs\\Dedicated.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
