{
  "template": "myth_of_empires",
  "title": "Myth of Empires",
  "category": "Survival / crafting",
  "burden": {"ram_gb": 8, "ram_gb_per_player": 0.06, "cpu_cores": 1.5, "cpu_cores_per_player": 0.03, "players": 50},
  "description": "Myth of Empires dedicated server (Steam app 1794810), started the way its PrivateServerTool's start file does it - main map, local data files, game and query ports, and a shutdown service on this PC only. Give your public IP so it is listed. It has no remote console, so players can't be warned before a restart (updates wait until nobody is on); stops use Ctrl+C. Fine-tune everything else with PrivateServerTool.exe in the install folder (its settings go into the files under MOE\\Saved). ServerDeck hasn't run this server on real hardware. About 8-12 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "moe", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Myth of Empires"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\MythOfEmpires"},
    {"key": "server_name", "label": "Server name (in the server list)", "default": "My Myth of Empires Server"},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 50},
    {"key": "pvp", "label": "PvP (1 = on, 0 = off)", "type": "int", "default": 1},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 11888, "help": "the shutdown service gets this + 2000 (this PC only)"},
    {"key": "query_port", "label": "Query port (UDP)", "type": "int", "default": 12888},
    {"key": "public_ip", "label": "Public IP address", "default": "", "help": "what players connect to - optional"},
    {"key": "shutdown_key", "label": "Shutdown service key", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "max_players": "{max_players}",
    "type": "win_process",
    "appid": 1794810,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_1794810.acf",
    "exe": "MOE\\Binaries\\Win64\\MOEServer.exe",
    "raw_args": true,
    "args": ["LargeTerrain_Central_Main", "-game", "-server", "-DataLocalFile", "-NotCheckServerSteamAuth", "-log",
             "-OutAddress={public_ip}", "-SessionName=\"{server_name}\"", "-PrivateServerPassword={password}",
             "-GameServerPVPType={pvp}", "-MaxPlayers={max_players}", "-MapDifficultyRate=1", "-EnableVACBan=1",
             "-ServerId=100", "-ClusterId=1", "-Port={port}", "-QueryPort={query_port}",
             "-bStartShutDownServiceInPrivateServer=true", "-ShutDownServiceIP=127.0.0.1",
             "-ShutDownServicePort={port+2000}", "-ShutDownServiceKey={shutdown_key}"],
    "ports": [["udp", "{port}"], ["udp", "{query_port}"]],
    "query": null,
    "stop_method": "ctrl_c",
    "stop_timeout": 120,
    "start_timeout": 1500,
    "firewall": "auto",
    "health": {"startup_grace": 1500},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 0},
    "backup": {"paths": ["MOE\\Saved"], "exclude": ["Logs", "Crashes"], "dest": "{backup_root}\\{id}"},
    "config_files": ["MOE/Saved/Config/WindowsServer/*.ini"],
    "logs": {"server log": "{install_dir}\\MOE\\Saved\\Logs\\*.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
