{
  "template": "hldms",
  "title": "Half-Life Deathmatch: Source",
  "category": "Shooters",
  "description": "Half-Life Deathmatch: Source dedicated server (Steam app 255470), the 32-bit srcds.exe (srcds_win64.exe if that's all there is). ServerDeck sets the name and join password in server.cfg on the first start and keeps its RCON password in step, lists who is on with kicks and bans over RCON (bans go into banned_user.cfg and are applied again after every start), warns players in chat before restarts and stops it cleanly. Admins: the RCON password, or SourceMod's admins_simple.ini. Under 1 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "hldms", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Half-Life Deathmatch: Source"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\HLDMS"},
    {"key": "server_name", "label": "Server name (in the browser)", "default": "My HLDM:S Server", "help": "written to server.cfg on the first start - change it there later"},
    {"key": "port", "label": "Game port (UDP/TCP)", "type": "int", "default": 27165},
    {"key": "map", "label": "Start map", "default": "crossfire"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 16},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "rcon_password", "label": "RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "type": "win_process",
    "appid": 255470,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_255470.acf",
    "exe": "srcds.exe",
    "exe_fallback": "srcds_win64.exe",
    "args": ["-console", "-game", "hl1mp", "-port", "{port}", "+ip", "0.0.0.0", "-nohltv", "-condebug",
             "+maxplayers", "{max_players}", "+map", "{map}", "+rcon_password", "{rcon_password}"],
    "ports": [["udp", "{port}"], ["tcp", "{port}"]],
    "query": {"port": "{port}"},
    "rcon": {"kind": "source", "port": "{port}", "password": "{rcon_password}"},
    "players": "srcds_rcon",
    "stop_method": "rcon",
    "stop_timeout": 30,
    "start_timeout": 300,
    "firewall": "auto",
    "announce": "rcon_say",
    "health": {"startup_grace": 300},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "pre_start": [["settings", {"file": "hl1mp\\cfg\\server.cfg", "format": "cfg",
      "seed": {"hostname": "{server_name}", "sv_password": "{password}"}, "enforce": {"rcon_password": "{rcon_password}"}}],
                  ["rotate", "hl1mp\\console.log", 20, 3]],
    "backup": {"paths": ["hl1mp\\cfg", "hl1mp\\addons"], "dest": "{backup_root}\\{id}"},
    "config_files": ["hl1mp/cfg/server.cfg", "hl1mp/cfg/mapcycle.txt", "hl1mp/cfg/banned_user.cfg"],
    "logs": {"server console": "{install_dir}\\hl1mp\\console.log", "server logs": "{install_dir}\\hl1mp\\logs\\*.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
