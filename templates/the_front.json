{
  "template": "the_front",
  "title": "The Front",
  "category": "Survival / crafting",
  "description": "The Front dedicated server (Steam app 2612550, the Windows one). It uses four ports in a row: game, beacon, query (UDP) and a shutdown service that stays on this PC. Give your public IP so it is listed correctly, and the Steam IDs of your admins. It has no remote console, so players can't be warned before a restart (updates wait until nobody is on); stops use Ctrl+C. The launch line follows the published dedicated-server setup guides; ServerDeck hasn't run this server on real hardware. About 8 GB of RAM or more.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "thefront", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "The Front"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\TheFront"},
    {"key": "server_name", "label": "Server name (in the server list)", "default": "My The Front Server"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 20},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 5005, "help": "the next two (beacon, query) are UDP too; the one after is the shutdown service"},
    {"key": "public_ip", "label": "Public IP address", "default": "", "help": "what players connect to - optional"},
    {"key": "admins", "label": "Admin Steam IDs", "default": "", "help": "SteamID64s separated by ; - optional"},
    {"key": "server_id", "label": "Server ID", "type": "int", "default": 1, "help": "any number, unique per server"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "type": "win_process",
    "appid": 2612550,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_2612550.acf",
    "exe": "ProjectWar\\Binaries\\Win64\\TheFrontServer.exe",
    "raw_args": true,
    "args": ["ProjectWar", "ProjectWar_Start?DedicatedServer?MaxPlayers={max_players}", "-server", "-game",
             "-QueueThreshold={max_players}", "-ServerName=\"{server_name}\"", "-ServerAdminAccounts={admins}", "-log",
             "-locallogtimes", "-EnableParallelCharacterMovementTickFunction", "-EnableParallelCharacterTickFunction",
             "-UseDynamicPhysicsScene", "-OutIPAddress={public_ip}", "-ServerID={server_id}", "-port={port}",
             "-BeaconPort={port+1}", "-QueryPort={port+2}", "-Game.PhysicsVehicle=false", "-ansimalloc",
             "-Game.MaxFrameRate=35", "-ShutDownServicePort={port+3}"],
    "ports": [["udp", "{port}"], ["udp", "{port+1}"], ["udp", "{port+2}"]],
    "query": null,
    "stop_method": "ctrl_c",
    "stop_timeout": 120,
    "start_timeout": 1200,
    "firewall": "auto",
    "health": {"startup_grace": 1200},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 0},
    "backup": {"paths": ["ProjectWar\\Saved"], "exclude": ["Logs", "Crashes"], "dest": "{backup_root}\\{id}"},
    "config_files": ["ProjectWar/Saved/Config/WindowsServer/*.ini"],
    "logs": {"server log": "{install_dir}\\ProjectWar\\Saved\\Logs\\*.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
