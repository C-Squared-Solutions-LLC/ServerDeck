{
  "template": "tf2",
  "title": "Team Fortress 2",
  "category": "Shooters",
  "description": "Team Fortress 2 dedicated server (Steam app 232250), 64-bit (srcds_win64.exe, or srcds.exe where a build has no 64-bit one). ServerDeck sets the name and join password in server.cfg on the first start and keeps its RCON password in step, lists who is on with kicks and bans over RCON (bans go into banned_user.cfg and are applied again after every start), warns players in chat before restarts and stops it cleanly. To show up in the public server list it needs a Game Server Login Token for app 440. Admins: the RCON password, or SourceMod's admins_simple.ini. About 1 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "tf2", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Team Fortress 2"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\TF2"},
    {"key": "server_name", "label": "Server name (in the browser)", "default": "My TF2 Server", "help": "written to server.cfg on the first start - change it there later"},
    {"key": "port", "label": "Game port (UDP/TCP)", "type": "int", "default": 27125},
    {"key": "map", "label": "Start map", "default": "ctf_2fort"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 24},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "gslt", "label": "Game Server Login Token", "default": "", "secret": true, "help": "app 440, from steamcommunity.com/dev/managegameservers - without one the server is joinable by IP only"},
    {"key": "rcon_password", "label": "RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "type": "win_process",
    "appid": 232250,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_232250.acf",
    "exe": "srcds_win64.exe",
    "exe_fallback": "srcds.exe",
    "args": ["-console", "-game", "tf", "-port", "{port}", "+ip", "0.0.0.0", "-nohltv", "-condebug",
             "+maxplayers", "{max_players}", "+map", "{map}", "+sv_setsteamaccount", "{gslt}", "+rcon_password", "{rcon_password}"],
    "ports": [["udp", "{port}"], ["tcp", "{port}"]],
    "query": {"port": "{port}"},
    "rcon": {"kind": "source", "port": "{port}", "password": "{rcon_password}"},
    "players": "srcds_rcon",
    "stop_method": "rcon",
    "stop_timeout": 30,
    "start_timeout": 300,
    "firewall": "auto",
    "announce": "rcon_say",
    "health": {"startup_grace": 300},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "pre_start": [["settings", {"file": "tf\\cfg\\server.cfg", "format": "cfg",
      "seed": {"hostname": "{server_name}", "sv_password": "{password}"}, "enforce": {"rcon_password": "{rcon_password}"}}],
                  ["rotate", "tf\\console.log", 20, 3]],
    "backup": {"paths": ["tf\\cfg", "tf\\addons"], "dest": "{backup_root}\\{id}"},
    "config_files": ["tf/cfg/server.cfg", "tf/cfg/mapcycle.txt", "tf/cfg/banned_user.cfg", "tf/cfg/motd.txt"],
    "logs": {"server console": "{install_dir}\\tf\\console.log", "server logs": "{install_dir}\\tf\\logs\\*.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
