{
  "template": "space_engineers",
  "title": "Space Engineers",
  "category": "Sandbox / sim",
  "burden": {"ram_gb": 3, "ram_gb_per_player": 0.05, "cpu_cores": 1, "cpu_cores_per_player": 0.03, "players": 16, "note": "worlds with many ships and stations need a lot more of both"},
  "description": "Space Engineers dedicated server (Steam app 298740), no configurator needed: Install downloads it, and the first start makes a new world from one of the scenarios that come with it (Star System, Earth Planet, Empty World, ...) and writes SpaceEngineers-Dedicated.cfg - name, ports, player cap and the Remote API ServerDeck uses for sim speed, who is on (kick, ban) and warnings. It runs in console mode; Ctrl+C stops it and saves the world. Admins are given from ServerDeck too. About 3 GB of RAM to start with.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "se", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Space Engineers"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\SpaceEngineers"},
    {"key": "instance_dir", "label": "Instance folder", "default": "C:\\GameServers\\SpaceEngineers\\Instance", "help": "the world, SpaceEngineers-Dedicated.cfg and the logs go here"},
    {"key": "server_name", "label": "Server name", "default": "My Space Engineers Server"},
    {"key": "world", "label": "Scenario for the new world", "default": "Star System", "help": "a folder name in Content\\CustomWorlds, e.g. Star System, Earth Planet, Empty World"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 16},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 27016},
    {"key": "steam_port", "label": "Steam port (UDP)", "type": "int", "default": 8767, "help": "8766 is the usual one"},
    {"key": "remote_api_port", "label": "Remote API port (local)", "type": "int", "default": 8081, "help": "8080 is the usual one"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "max_players": "{max_players}",
    "type": "win_process",
    "appid": 298740,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_298740.acf",
    "exe": "DedicatedServer64\\SpaceEngineersDedicated.exe",
    "args": ["-console", "-path", "{instance_dir}", "-ignorelastsession"],
    "ports": [["udp", "{port}"]],
    "extra_ports": [["udp", "{steam_port}"]],
    "query": {"host": "127.0.0.1", "port": "{port}"},
    "start_timeout": 900,
    "stop_method": "ctrl_c",
    "stop_timeout": 120,
    "firewall": "auto",
    "pre_start": [["se_instance", {"dir": "{instance_dir}", "world": "{world}", "server_name": "{server_name}", "port": "{port}",
                                   "steam_port": "{steam_port}", "remote_api_port": "{remote_api_port}", "max_players": "{max_players}"}]],
    "backup": {"paths": ["{instance_dir}\\Saves"], "dest": "{backup_root}\\{id}"},
    "config_files": ["{instance_dir}\\SpaceEngineers-Dedicated.cfg", "{instance_dir}\\Saves\\*\\Sandbox_config.sbc"],
    "announce": "se_chat",
    "remote_api": {"port": "{remote_api_port}", "key": "{xml:{instance_dir}\\SpaceEngineers-Dedicated.cfg:RemoteSecurityKey}"},
    "perf": {"kind": "se_remote"},
    "health": {"min_sim_speed": 0.8},
    "schedule": {"enabled": false, "every_hours": 12, "start": "04:00", "warn_minutes": 10},
    "logs": {"server log": "{instance_dir}\\SpaceEngineersDedicated_*.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
