{
  "template": "seven_days",
  "title": "7 Days to Die",
  "category": "Survival / crafting",
  "description": "7 Days to Die dedicated server (Steam app 294420). On the first start ServerDeck writes the name, join password, slots, world and save name into serverconfig.xml, puts the saves in a UserData folder next to the server (so backups include them) and switches on the telnet console with no password - 7 Days to Die then listens on this PC only. Through it ServerDeck lists who is on (kick, ban), warns players in chat before restarts and stops cleanly (saveworld + shutdown). Its web dashboard stays off (it would take port 8080). Admins and their permission levels: serveradmin.xml under Configs. A random world (World: RWG) is generated on the first start, which can take a long while. About 4-8 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "7dtd", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "7 Days to Die"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\7DaysToDie"},
    {"key": "server_name", "label": "Server name (in the server browser)", "default": "My 7 Days to Die Server", "help": "written to serverconfig.xml on the first start - change it there later"},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "port", "label": "Game port (TCP + UDP)", "type": "int", "default": 26900, "help": "the next two UDP ports are used too"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 8},
    {"key": "world", "label": "World", "default": "Navezgane", "help": "Navezgane, or RWG for a random world (seed and size in serverconfig.xml)"},
    {"key": "game_name", "label": "Save name", "default": "MyGame"},
    {"key": "telnet_port", "label": "Telnet console port (this PC only)", "type": "int", "default": 8081}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "type": "win_process",
    "appid": 294420,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_294420.acf",
    "exe": "7DaysToDieServer.exe",
    "args": ["-logfile", "{install_dir}\\logs\\output_log.txt", "-quit", "-batchmode", "-nographics",
             "-configfile=serverconfig.xml", "-dedicated"],
    "ports": [["tcp", "{port}"], ["udp", "{port}"], ["udp", "{port+1}"], ["udp", "{port+2}"]],
    "query": {"port": "{port}"},
    "rcon": {"kind": "telnet", "port": "{telnet_port}", "password": "", "say": "say \"{msg}\"", "stop": ["saveworld", "shutdown"]},
    "players": "7dtd_telnet",
    "max_players": "{max_players}",
    "stop_method": "rcon",
    "stop_timeout": 120,
    "start_timeout": 1800,
    "firewall": "auto",
    "announce": "rcon_say",
    "health": {"startup_grace": 1800},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "pre_start": [["settings", {"file": "serverconfig.xml", "format": "xmlprop",
      "seed": {"ServerName": "{server_name}", "ServerPassword": "{password}", "ServerMaxPlayerCount": "{max_players}",
               "GameWorld": "{world}", "GameName": "{game_name}", "UserDataFolder": "{install_dir}\\UserData"},
      "enforce": {"ServerPort": "{port}", "TelnetEnabled": "true", "TelnetPort": "{telnet_port}", "TelnetPassword": "",
                  "WebDashboardEnabled": "false"}}]],
    "backup": {"paths": ["UserData", "serverconfig.xml"], "exclude": ["logs"], "dest": "{backup_root}\\{id}"},
    "config_files": ["serverconfig.xml", "UserData/Saves/serveradmin.xml"],
    "logs": {"server log": "{install_dir}\\logs\\output_log.txt"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
