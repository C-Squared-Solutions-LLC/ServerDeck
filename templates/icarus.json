{
  "template": "icarus",
  "title": "ICARUS",
  "category": "Survival / crafting",
  "burden": {"ram_gb": 5, "ram_gb_per_player": 0.4, "cpu_cores": 1, "cpu_cores_per_player": 0.15, "players": 8},
  "description": "ICARUS dedicated server (Steam app 2089300). On the first start ServerDeck writes the session name, join password, slots and admin password into ServerSettings.ini, and before every start turns off its own auto-shutdown (it stops itself when nobody joins - ServerDeck keeps it online instead). Players pick or start a prospect from the lobby; admins log in in game with the admin password. It has no remote console, so players can't be warned before a restart (updates wait until nobody is on), and ServerDeck sees only who is on. Stops use Ctrl+C. The query port is 27035 here (27015 is SCUM's on this PC). About 6-10 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "icarus", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "ICARUS"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\Icarus"},
    {"key": "server_name", "label": "Server name (in the server list)", "default": "My ICARUS Server"},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "admin_password", "label": "Admin password (in game)", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 8},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 17777},
    {"key": "query_port", "label": "Query port (UDP)", "type": "int", "default": 27035}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "max_players": "{max_players}",
    "type": "win_process",
    "appid": 2089300,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_2089300.acf",
    "exe": "IcarusServer.exe",
    "process": "IcarusServer-Win64-*.exe",
    "raw_args": true,
    "args": ["-Log", "-SteamServerName=\"{server_name}\"", "-PORT={port}", "-QueryPort={query_port}"],
    "ports": [["udp", "{port}"], ["udp", "{query_port}"]],
    "query": {"port": "{query_port}"},
    "player_notes": {"ban": "ICARUS bans and kicks in game (admin password).", "roles": "Admins log in in game with the admin password (ServerSettings.ini)."},
    "stop_method": "ctrl_c",
    "stop_timeout": 120,
    "start_timeout": 900,
    "firewall": "auto",
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 0},
    "pre_start": [["settings", {"file": "Icarus\\Saved\\Config\\WindowsServer\\ServerSettings.ini", "format": "ini",
      "seed": {"/Script/Icarus.DedicatedServerSettings/SessionName": "{server_name}",
               "/Script/Icarus.DedicatedServerSettings/JoinPassword": "{password}",
               "/Script/Icarus.DedicatedServerSettings/MaxPlayers": "{max_players}",
               "/Script/Icarus.DedicatedServerSettings/AdminPassword": "{admin_password}"},
      "enforce": {"/Script/Icarus.DedicatedServerSettings/ShutdownIfNotJoinedFor": "-1",
                  "/Script/Icarus.DedicatedServerSettings/ShutdownIfEmptyFor": "-1"}}]],
    "backup": {"paths": ["Icarus\\Saved"], "exclude": ["Logs", "Crashes"], "dest": "{backup_root}\\{id}"},
    "config_files": ["Icarus/Saved/Config/WindowsServer/*.ini"],
    "logs": {"server log": "{install_dir}\\Icarus\\Saved\\Logs\\Icarus.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
