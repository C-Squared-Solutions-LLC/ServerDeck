{
  "template": "css",
  "title": "Counter-Strike: Source",
  "category": "Shooters",
  "description": "Counter-Strike: Source dedicated server (Steam app 232330), 64-bit (srcds_win64.exe, or srcds.exe where a build has no 64-bit one). ServerDeck sets the name and join password in server.cfg on the first start and keeps its RCON password in step, lists who is on with kicks and bans over RCON (bans go into banned_user.cfg and are applied again after every start), warns players in chat before restarts and stops it cleanly. Admins: there is no built-in admin list - use the RCON password, or add SourceMod and its admins_simple.ini. About 1 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "css", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Counter-Strike: Source"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\CSS"},
    {"key": "server_name", "label": "Server name (in the browser)", "default": "My CS:S Server", "help": "written to server.cfg on the first start - change it there later"},
    {"key": "port", "label": "Game port (UDP/TCP)", "type": "int", "default": 27115},
    {"key": "map", "label": "Start map", "default": "de_dust2"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 24},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "gslt", "label": "Game Server Login Token", "default": "", "secret": true, "help": "optional (app 240) - steamcommunity.com/dev/managegameservers"},
    {"key": "rcon_password", "label": "RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "type": "win_process",
    "appid": 232330,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_232330.acf",
    "exe": "srcds_win64.exe",
    "exe_fallback": "srcds.exe",
    "args": ["-console", "-game", "cstrike", "-port", "{port}", "+ip", "0.0.0.0", "-nohltv", "-condebug",
             "+maxplayers", "{max_players}", "+map", "{map}", "+sv_setsteamaccount", "{gslt}", "+rcon_password", "{rcon_password}"],
    "ports": [["udp", "{port}"], ["tcp", "{port}"]],
    "query": {"port": "{port}"},
    "rcon": {"kind": "source", "port": "{port}", "password": "{rcon_password}"},
    "players": "srcds_rcon",
    "stop_method": "rcon",
    "stop_timeout": 30,
    "start_timeout": 300,
    "firewall": "auto",
    "announce": "rcon_say",
    "health": {"startup_grace": 300},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "pre_start": [["settings", {"file": "cstrike\\cfg\\server.cfg", "format": "cfg",
      "seed": {"hostname": "{server_name}", "sv_password": "{password}"}, "enforce": {"rcon_password": "{rcon_password}"}}],
                  ["rotate", "cstrike\\console.log", 20, 3]],
    "backup": {"paths": ["cstrike\\cfg", "cstrike\\addons"], "dest": "{backup_root}\\{id}"},
    "config_files": ["cstrike/cfg/server.cfg", "cstrike/cfg/mapcycle.txt", "cstrike/cfg/banned_user.cfg", "cstrike/motd.txt"],
    "logs": {"server console": "{install_dir}\\cstrike\\console.log", "server logs": "{install_dir}\\cstrike\\logs\\*.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
