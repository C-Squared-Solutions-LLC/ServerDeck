{
  "template": "rust",
  "title": "Rust",
  "description": "Rust dedicated server (Steam app 258550) with Oxide (uMod) re-installed after every game update - your plugins, configs and data are never touched. The first start generates the map and can take 10-30 minutes.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "rust", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Rust"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\Rust"},
    {"key": "hostname", "label": "Server name (in the browser)", "default": "My Rust Server"},
    {"key": "identity", "label": "Identity (save folder name)", "default": "rustserver"},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 28015},
    {"key": "query_port", "label": "Query port (UDP)", "type": "int", "default": 28017},
    {"key": "rcon_port", "label": "RCON port (TCP)", "type": "int", "default": 28016},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 50},
    {"key": "world_size", "label": "World size", "type": "int", "default": 3500},
    {"key": "seed", "label": "Map seed", "type": "int", "default": 12345},
    {"key": "rcon_password", "label": "RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "type": "win_process",
    "appid": 258550,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_258550.acf",
    "exe": "RustDedicated.exe",
    "args": ["-batchmode", "+server.identity", "{identity}", "+server.hostname", "{hostname}",
             "+server.port", "{port}", "+server.queryport", "{query_port}",
             "+server.maxplayers", "{max_players}", "+server.worldsize", "{world_size}", "+server.seed", "{seed}",
             "+rcon.port", "{rcon_port}", "+rcon.web", "1", "+rcon.password", "{rcon_password}",
             "-logfile", "{install_dir}\\logs\\console.log"],
    "ports": [["udp", "{port}"], ["udp", "{query_port}"], ["tcp", "{rcon_port}"]],
    "query": {"port": "{query_port}"},
    "rcon": {"kind": "web", "port": "{rcon_port}", "password": "{rcon_password}"},
    "stop_method": "rcon",
    "stop_timeout": 180,
    "start_timeout": 2400,
    "firewall": "auto",
    "announce": "rcon_say",
    "perf": {"kind": "rust_serverinfo"},
    "health": {"min_fps_idle": 15, "min_fps_busy": 20, "startup_grace": 2400},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "mods": "rust",
    "mod_releases": {"oxide": "OxideMod/Oxide.Rust"},
    "pre_start": [["rust_oxide_present"]],
    "post_update": [["rust_oxide"]],
    "backup": {"paths": ["oxide", "server\\{identity}"], "exclude": ["logs"], "dest": "{backup_root}\\{id}"},
    "config_files": ["server/{identity}/cfg/*.cfg", "server/{identity}/cfg/*.json", "oxide/config/*.json"],
    "logs": {
      "server console": "{install_dir}\\logs\\console.log",
      "Oxide / plugins": "{install_dir}\\oxide\\logs\\*.txt"
    },
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
