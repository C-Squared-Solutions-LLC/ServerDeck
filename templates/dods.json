{
  "template": "dods",
  "title": "Day of Defeat: Source",
  "category": "Shooters",
  "description": "Day of Defeat: Source dedicated server (Steam app 232290), 64-bit (srcds_win64.exe, or srcds.exe where a build has no 64-bit one). ServerDeck sets the name and join password in server.cfg on the first start and keeps its RCON password in step, lists who is on with kicks and bans over RCON (bans go into banned_user.cfg and are applied again after every start), warns players in chat before restarts and stops it cleanly. Admins: the RCON password, or SourceMod's admins_simple.ini. About 1 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "dods", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Day of Defeat: Source"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\DODS"},
    {"key": "server_name", "label": "Server name (in the browser)", "default": "My DoD:S Server", "help": "written to server.cfg on the first start - change it there later"},
    {"key": "port", "label": "Game port (UDP/TCP)", "type": "int", "default": 27145},
    {"key": "map", "label": "Start map", "default": "dod_anzio"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 24},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "rcon_password", "label": "RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "type": "win_process",
    "appid": 232290,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_232290.acf",
    "exe": "srcds_win64.exe",
    "exe_fallback": "srcds.exe",
    "args": ["-console", "-game", "dod", "-port", "{port}", "+ip", "0.0.0.0", "-nohltv", "-condebug",
             "+maxplayers", "{max_players}", "+map", "{map}", "+rcon_password", "{rcon_password}"],
    "ports": [["udp", "{port}"], ["tcp", "{port}"]],
    "query": {"port": "{port}"},
    "rcon": {"kind": "source", "port": "{port}", "password": "{rcon_password}"},
    "players": "srcds_rcon",
    "stop_method": "rcon",
    "stop_timeout": 30,
    "start_timeout": 300,
    "firewall": "auto",
    "announce": "rcon_say",
    "health": {"startup_grace": 300},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "pre_start": [["settings", {"file": "dod\\cfg\\server.cfg", "format": "cfg",
      "seed": {"hostname": "{server_name}", "sv_password": "{password}"}, "enforce": {"rcon_password": "{rcon_password}"}}],
                  ["rotate", "dod\\console.log", 20, 3]],
    "backup": {"paths": ["dod\\cfg", "dod\\addons"], "dest": "{backup_root}\\{id}"},
    "config_files": ["dod/cfg/server.cfg", "dod/cfg/mapcycle.txt", "dod/cfg/banned_user.cfg"],
    "logs": {"server console": "{install_dir}\\dod\\console.log", "server logs": "{install_dir}\\dod\\logs\\*.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
