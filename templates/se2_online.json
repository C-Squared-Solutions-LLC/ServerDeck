{
  "template": "se2_online",
  "title": "Space Engineers 2 (SE2 Online)",
  "category": "Sandbox / sim",
  "burden": {"ram_gb": 8, "ram_gb_per_player": 0.25, "cpu_cores": 2, "cpu_cores_per_player": 0.1, "players": 8, "note": "SE2 has no official dedicated server yet: this is the community SE2 Online server, which runs the game itself headless"},
  "description": "Space Engineers 2 dedicated server from SE2 Online by Yellow51 (not Steam): unzip its standalone package (Y51_SE2Online-DedicatedServer-<version>-standalone-win-x64.zip, the game files included) into the install folder. On the first start ServerDeck writes server.json from server.example.json - name, slots, port - and keeps its remote console (RCON) on, reachable from this PC only, for chat warnings and saving the world on every stop. Edit the rest of server.json under Configs. The server updates itself (AutoUpdate in server.json). Forward the game port and the next one (UDP).",
  "fields": [
    {"key": "id", "label": "Short id", "default": "se2", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Space Engineers 2"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\SE2Online", "help": "where the standalone package is unzipped"},
    {"key": "server_name", "label": "Server name (in the server browser)", "default": "My SE2 Server"},
    {"key": "world", "label": "World name", "default": "SE2 World"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 8},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 27016, "help": "the Steam query port is the next one"},
    {"key": "rcon_port", "label": "RCON port (TCP, this PC only)", "type": "int", "default": 27020},
    {"key": "rcon_password", "label": "RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "max_players": "{max_players}",
    "type": "win_process",
    "install_dir": "{install_dir}",
    "exe": "Y51_SE2Online.DedicatedServer.exe",
    "args": [],
    "tree": true,
    "ports": [["udp", "{port}"]],
    "extra_ports": [["udp", "{port+1}"]],
    "query": null,
    "rcon": {"kind": "source", "port": "{rcon_port}", "password": "{rcon_password}", "say": "say {msg}", "stop": ["stop now"]},
    "stop_method": "rcon",
    "stop_timeout": 120,
    "start_timeout": 900,
    "firewall": "auto",
    "announce": "rcon_say",
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "pre_start": [["settings", {"file": "server.json", "format": "json", "copy": "server.example.json",
                                "seed": {"WorldName": "{world}", "Network.SessionName": "{server_name}",
                                         "Network.MaxPlayers": "{max_players}"},
                                "enforce": {"Network.ListenPort": "{port}", "RconEnabled": true, "RconPort": "{rcon_port}",
                                            "RconBindAddress": "127.0.0.1", "RconPassword": "{rcon_password}"}}]],
    "backup": {"paths": ["profile\\AppData\\SaveGames", "server.json", "access.json", "Permissions"], "dest": "{backup_root}\\{id}"},
    "config_files": ["server.json", "Permissions/*.json", "Permissions/Groups/*.json"],
    "logs": {"console": "{install_dir}\\dedicated-console.jsonl", "game log": "{install_dir}\\profile\\Temp\\Logs\\*.log"},
    "defaults": {"keep_online": true, "auto_update": false}
  }
}
