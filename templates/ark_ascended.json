{
  "template": "ark_ascended",
  "title": "ARK: Survival Ascended",
  "category": "Survival / crafting",
  "description": "ARK: Survival Ascended dedicated server (Steam app 2430930), BattlEye off. ServerDeck starts it with RCON on (password = the admin password) and uses it for who is on, player counts (ASA doesn't answer Steam queries), restart warnings in chat and clean stops (SaveWorld, then DoExit). Players have Epic (EOS) ids, not Steam ids: the Players list shows each id - kick or ban in the RCON console (Logs & console) with KickPlayer <id> / BanPlayer <id>. Admins: AllowedCheaterAccountIDs.txt (Configs) or the admin password in game. Uses UDP 7787 here (7777 is the usual port; SCUM has it on this PC). Heavy: plan on 12-16 GB of RAM for The Island and a long first start.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "asa", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "ARK: Survival Ascended"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\ARKAscended"},
    {"key": "server_name", "label": "Session name (in the server list)", "default": "My ASA Server"},
    {"key": "map", "label": "Map", "default": "TheIsland_WP", "help": "e.g. TheIsland_WP, ScorchedEarth_WP, TheCenter_WP, Aberration_WP, Extinction_WP, Ragnarok_WP"},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 7787},
    {"key": "rcon_port", "label": "RCON port (TCP, this PC only)", "type": "int", "default": 27020},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 20},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "admin_password", "label": "Admin / RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "type": "win_process",
    "appid": 2430930,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_2430930.acf",
    "exe": "ShooterGame\\Binaries\\Win64\\ArkAscendedServer.exe",
    "args": ["{map}?listen?SessionName={server_name}?Port={port}?ServerPassword={password}?ServerAdminPassword={admin_password}?RCONEnabled=True?RCONPort={rcon_port}",
             "-WinLiveMaxPlayers={max_players}", "-log"],
    "ports": [["udp", "{port}"], ["tcp", "{rcon_port}"]],
    "query": null,
    "rcon": {"kind": "source", "port": "{rcon_port}", "password": "{admin_password}", "say": "ServerChat {msg}",
             "stop": ["SaveWorld", "DoExit"]},
    "players": "asa_rcon",
    "max_players": "{max_players}",
    "stop_method": "rcon",
    "stop_timeout": 300,
    "start_timeout": 1800,
    "firewall": "auto",
    "announce": "rcon_say",
    "health": {"startup_grace": 1800},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "backup": {"paths": ["ShooterGame\\Saved"], "exclude": ["Logs", "Crashes"], "dest": "{backup_root}\\{id}"},
    "config_files": ["ShooterGame/Saved/Config/WindowsServer/*.ini", "ShooterGame/Saved/AllowedCheaterAccountIDs.txt"],
    "logs": {"server log": "{install_dir}\\ShooterGame\\Saved\\Logs\\ShooterGame.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
