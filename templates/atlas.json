{
  "template": "atlas",
  "title": "ATLAS",
  "category": "Survival / crafting",
  "burden": {"ram_gb": 7, "ram_gb_per_player": 0.1, "cpu_cores": 1.5, "cpu_cores_per_player": 0.05, "players": 20, "note": "for one grid cell; every extra cell is another server about this size"},
  "description": "ATLAS dedicated server (Steam app 1006030), run as a single grid (cell 0,0). ATLAS needs its Redis database: ServerDeck starts the copy that comes with the server (AtlasTools\\RedisDatabase) before ATLAS and leaves it running. Before the first start make ShooterGame\\ServerGrid.json describe your grid with ATLAS's ServerGridEditor: a 1x1 grid whose cell 0,0 has this PC's public address and the ports below, and the Redis password from AtlasTools\\RedisDatabase\\redis.conf. ServerDeck uses RCON (password = the admin password) for who is on (kick, ban - Steam IDs), restart warnings and clean stops (SaveWorld, DoExit). Official ATLAS servers are gone and the game gets no more updates. About 6-10 GB of RAM.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "atlas", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "ATLAS"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\Atlas"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 20},
    {"key": "port", "label": "Game port (UDP)", "type": "int", "default": 5755},
    {"key": "query_port", "label": "Query port (UDP)", "type": "int", "default": 57555},
    {"key": "seamless_port", "label": "Seamless data port (TCP)", "type": "int", "default": 27000},
    {"key": "rcon_port", "label": "RCON port (TCP, this PC only)", "type": "int", "default": 32330},
    {"key": "public_ip", "label": "Public IP address", "default": "", "help": "the same as in ServerGrid.json - optional for a single grid"},
    {"key": "admin_password", "label": "Admin / RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "type": "win_process",
    "appid": 1006030,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_1006030.acf",
    "exe": "ShooterGame\\Binaries\\Win64\\ShooterGameServer.exe",
    "args": ["Ocean?ServerX=0?ServerY=0?AltSaveDirectoryName=00?MaxPlayers={max_players}?ReservedPlayerSlots=0?QueryPort={query_port}?Port={port}?SeamlessIP={public_ip}?RCONEnabled=True?RCONPort={rcon_port}?ServerAdminPassword={admin_password}",
             "-log", "-server", "-NoBattlEye"],
    "ports": [["udp", "{port}"], ["udp", "{query_port}"], ["tcp", "{seamless_port}"], ["tcp", "{rcon_port}"]],
    "query": {"port": "{query_port}"},
    "rcon": {"kind": "source", "port": "{rcon_port}", "password": "{admin_password}", "say": "ServerChat {msg}",
             "stop": ["SaveWorld", "DoExit"]},
    "players": "ark_rcon",
    "max_players": "{max_players}",
    "stop_method": "rcon",
    "stop_timeout": 300,
    "start_timeout": 1800,
    "firewall": "auto",
    "announce": "rcon_say",
    "health": {"startup_grace": 1800},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "pre_start": [["helper", "AtlasTools\\RedisDatabase\\redis-server.exe", ["redis.conf"]]],
    "backup": {"paths": ["ShooterGame\\Saved", "ShooterGame\\ServerGrid.json", "AtlasTools\\RedisDatabase"],
               "exclude": ["Logs", "Crashes"], "dest": "{backup_root}\\{id}"},
    "config_files": ["ShooterGame/ServerGrid.json", "ShooterGame/Saved/Config/WindowsServer/*.ini", "AtlasTools/RedisDatabase/redis.conf"],
    "logs": {"server log": "{install_dir}\\ShooterGame\\Saved\\Logs\\*.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
