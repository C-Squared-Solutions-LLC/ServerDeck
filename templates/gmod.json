{
  "template": "gmod",
  "title": "Garry's Mod",
  "category": "Shooters",
  "burden": {"ram_gb": 1, "ram_gb_per_player": 0.03, "cpu_cores": 0.4, "cpu_cores_per_player": 0.03, "players": 16, "note": "addons and big maps add memory and CPU"},
  "description": "Garry's Mod dedicated server (Steam app 4020), the 32-bit build of the public branch (srcds.exe). ServerDeck sets the name and join password in server.cfg on the first start and keeps its RCON password in step, lists who is on with kicks and bans over RCON (bans go into banned_user.cfg and are applied again after every start), warns players in chat before restarts and stops it cleanly. Workshop content: give a collection ID (and a Steam Web API key in config.json's args as -authkey if the collection needs it). Admins: the RCON password, or an admin mod such as ULX (its files under Configs). A Game Server Login Token (app 4000) is optional. About 1-3 GB of RAM depending on addons.",
  "fields": [
    {"key": "id", "label": "Short id", "default": "gmod", "help": "letters, numbers, - and _"},
    {"key": "name", "label": "Display name", "default": "Garry's Mod"},
    {"key": "install_dir", "label": "Install folder", "default": "C:\\GameServers\\GarrysMod"},
    {"key": "server_name", "label": "Server name (in the browser)", "default": "My Garry's Mod Server", "help": "written to server.cfg on the first start - change it there later"},
    {"key": "port", "label": "Game port (UDP/TCP)", "type": "int", "default": 27135},
    {"key": "gamemode", "label": "Gamemode", "default": "sandbox", "help": "e.g. sandbox, terrortown, darkrp (if installed)"},
    {"key": "map", "label": "Start map", "default": "gm_construct"},
    {"key": "max_players", "label": "Max players", "type": "int", "default": 16},
    {"key": "workshop", "label": "Workshop collection ID", "default": "", "help": "optional"},
    {"key": "password", "label": "Join password", "default": "", "secret": true, "help": "optional"},
    {"key": "gslt", "label": "Game Server Login Token", "default": "", "secret": true, "help": "optional (app 4000)"},
    {"key": "rcon_password", "label": "RCON password", "default": "", "secret": true, "generate": true, "help": "left empty, a random one is made"}
  ],
  "server": {
    "id": "{id}",
    "name": "{name}",
    "max_players": "{max_players}",
    "type": "win_process",
    "appid": 4020,
    "install_dir": "{install_dir}",
    "steam_install_dir": "{install_dir}",
    "manifest": "{install_dir}\\steamapps\\appmanifest_4020.acf",
    "exe": "srcds.exe",
    "exe_fallback": "srcds_win64.exe",
    "args": ["-console", "-game", "garrysmod", "-port", "{port}", "+ip", "0.0.0.0", "-nohltv", "-condebug",
             "+maxplayers", "{max_players}", "+gamemode", "{gamemode}", "+map", "{map}",
             "+host_workshop_collection", "{workshop}", "+sv_setsteamaccount", "{gslt}", "+rcon_password", "{rcon_password}"],
    "ports": [["udp", "{port}"], ["tcp", "{port}"]],
    "query": {"port": "{port}"},
    "rcon": {"kind": "source", "port": "{port}", "password": "{rcon_password}"},
    "players": "srcds_rcon",
    "stop_method": "rcon",
    "stop_timeout": 30,
    "start_timeout": 600,
    "firewall": "auto",
    "announce": "rcon_say",
    "health": {"startup_grace": 600},
    "schedule": {"enabled": false, "every_hours": 12, "start": "06:00", "warn_minutes": 10},
    "pre_start": [["settings", {"file": "garrysmod\\cfg\\server.cfg", "format": "cfg",
      "seed": {"hostname": "{server_name}", "sv_password": "{password}"}, "enforce": {"rcon_password": "{rcon_password}"}}],
                  ["rotate", "garrysmod\\console.log", 20, 3]],
    "backup": {"paths": ["garrysmod\\cfg", "garrysmod\\data", "garrysmod\\settings", "garrysmod\\addons"], "exclude": ["cache"],
               "dest": "{backup_root}\\{id}"},
    "config_files": ["garrysmod/cfg/server.cfg", "garrysmod/cfg/banned_user.cfg", "garrysmod/settings/users.txt"],
    "logs": {"server console": "{install_dir}\\garrysmod\\console.log", "server logs": "{install_dir}\\garrysmod\\logs\\*.log"},
    "defaults": {"keep_online": true, "auto_update": true}
  }
}
